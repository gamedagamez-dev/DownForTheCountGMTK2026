transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -61.0791, 41.298637, -93.066826)
_name = "Head Count"
question_1 = "  Oh well hello there dear. I called all my children here for a family reunion, but now they've all scattered around and I can't find them all! Have you seen any of them?"
Q1_answer_correct = "   Yeah! They're all around here somewhere."
Q1_answer_wrong = "  Uhhhh... sorry no, I don't know what you're talking about."
Q1_failure = " Agh... Such a shame."
question_2 = " Oh, I'm so glad! I worry, you see. It's tiring having to keep track of where they all are."
Q2_answer_correct = "  Well I can make it easy for you to keep track of me."
Q2_answer_wrong = " Well, good luck with that!"
Q2_failure = "  Um. Thank you? I suppose. Goodbye."
question_3 = "Quite the charmer, aren't you? I'm sorry, I'm just very distracted and stressed right now. I hope all my children are alright."
Q3_answer_correct = " Don't worry, I'm great with kids."
Q3_answer_wrong = " Oh, sorry, I'll leave you alone then."
Q3_failure = " Ah. Okay, see you dear."
Conclusion = "  Oh! You know just what to say, haha! Oh, alright dear, you seem nice enough..."
Failure = "  Have a nice day."
Already_Failed = " G'day."
Already_Succeceded = " Have a very good night, and a better year!"


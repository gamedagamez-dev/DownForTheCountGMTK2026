[node name="CountErkulChurr" parent="Vampires" unique_id=344404732 instance=ExtResource("1_noce4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 59.786716, 2.5479975, -133.70612)
_name = "Count Erkul Churr"
question_1 = "Yooooooo, what's uppppppp. How's it hanging? You ever notice how corporate holidays like this have gotten recently? Crazy, right?"
Q1_answer_correct = "I know, I hate corporations, they suck."
Q1_answer_wrong = "Yeah! I love corporations, they keep our county running!"
Q1_failure = "Ugh. I thought you were cool... Nevermind."
question_2 = "Wow, you're actually smart. That's hard to come by these days. Who did you say you were again?"
Q2_answer_correct = "I like to think of myself as a rebel. Some kind of vigilante."
Q2_answer_wrong = "Just a regular person, trying to get by."
Q2_failure = "That's kinda lame, not gonna lie. See you around."
question_3 = "HELL yes. That's what I'm talking about! I bet you listen to the Unfits too."
Q3_answer_correct = "I prefer the Tram Team."
Q3_answer_wrong = "Whoa... you just blew my mind. I could kiss you right now. In fact..."
Q3_failure = "Hmmm... you don't sound like you really know them. You lying? I hate fakers."
Conclusion = "Our smooches are more powerful on New Years."
Failure = "Don't give me normie-cooties, haha, hah."
